# ============================================
# 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================

# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Xiaomi API Configuration
XIAOMI_API_KEY=your_xiaomi_api_key_here
XIAOMI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# Ark API Configuration (OpenAI compatible)
ARK_API_KEY=your_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3

# Zhipu AI Configuration
ZHIPU_API_KEY=your_zhipu_api_key_here

# MySQL Connection (for future database integration)
MYSQL_CONNECTION=mysql+pymysql://user:password@host:3306/dbname
MYSQL_CONNECTION_BASE=mysql+pymysql://user:password@host:3306/dbname

# Qiniu Cloud OSS Configuration
QINIU_ACCESS_KEY=your_qiniu_access_key_here
QINIU_SECRET_KEY=your_qiniu_secret_key_here
QINIU_BUCKET_NAME=your_bucket_name_here
QINIU_BUCKET_DOMAIN=your_bucket_domain_here
